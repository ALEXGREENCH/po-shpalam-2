{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "По Шпалам 2 — выпуск 01: реальная запись",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "sources",
    "topics",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "episode_number": {
      "const": 1
    },
    "status": {
      "enum": [
        "preparing",
        "recording",
        "complete"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "character",
          "chat_url"
        ],
        "properties": {
          "character": {
            "$ref": "#/$defs/character"
          },
          "chat_url": {
            "$ref": "#/$defs/sourceUrl"
          },
          "profile_url": {
            "type": "string",
            "format": "uri"
          },
          "author": {
            "type": "string"
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "phase"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "$ref": "#/$defs/phase"
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "index",
          "character",
          "phase",
          "topic_id",
          "source_url",
          "prompt",
          "raw",
          "display",
          "audio"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "character": {
            "$ref": "#/$defs/character"
          },
          "phase": {
            "$ref": "#/$defs/phase"
          },
          "topic_id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "$ref": "#/$defs/sourceUrl"
          },
          "prompt": {
            "type": "string",
            "description": "Exact input sent to the bot. This is context, not spoken output."
          },
          "raw": {
            "type": "string",
            "minLength": 1,
            "description": "Exact response received from Character.AI. Never generated by the builder."
          },
          "display": {
            "type": "string",
            "minLength": 1,
            "description": "Editorial version used for display; raw remains separate."
          },
          "editorial_note": {
            "type": ["string", "null"],
            "description": "Optional fact-check note displayed separately from the character's speech, collapsed by default. It is never narrated or inserted into raw/display."
          },
          "recorded_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "audio": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "file",
                  "moderated"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Relative file inside this episode's assets/audio directory. No URL or traversal."
                  },
                  "duration_seconds": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "description": "Builder discards supplied duration and measures WAV frames/sample_rate. Unknown stays null."
                  },
                  "moderated": {
                    "const": true
                  },
                  "sha256": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "verification": {
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    },
    "timing": {
      "type": "object",
      "readOnly": true,
      "description": "Generated from verified local audio files, never text length or intended running time."
    },
    "targets_seconds": {
      "type": "object",
      "readOnly": true,
      "description": "Production goals only: 600 seconds news, 1800 main, 2400 total."
    }
  },
  "$defs": {
    "character": {
      "enum": [
        "Мэддисон",
        "Хованский",
        "Понасенков"
      ]
    },
    "phase": {
      "enum": [
        "news",
        "main"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "pattern": "^https://(www\\.)?character\\.ai/",
      "description": "Actual Character.AI chat source URL."
    }
  },
  "$comment": "Unique indices, matching topic phases, local path containment, container signatures, and physical WAV duration are enforced by build_episode1.py."
}
